<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/console_background"
    android:importantForAutofill="noExcludeDescendants"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/bar_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/bar_text"
            android:textSize="18sp" />


        <Button
            android:id="@+id/reset"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reset" />

        <ImageButton
            android:id="@+id/menu"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/more"
            android:src="@drawable/ic_more"
            app:tint="@color/bar_text" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/bar_background"
        app:tabMode="auto"
        app:tabIndicatorColor="@color/accent"
        app:tabSelectedTextColor="@color/accent"
        app:tabTextColor="@color/label" />

    <FrameLayout
        android:id="@+id/panesFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:id="@+id/panes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Editor pane: left on wide screens -->
        <LinearLayout
            android:id="@+id/editorPane"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bar_background"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/fileTabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <io.github.leukoplast1980.solderless.ui.ForthEditor
                android:id="@+id/editor"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@null"
                android:importantForAutofill="no"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:scrollbars="vertical"
                android:textColor="@color/console_text"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bar_background"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/editorFiles"
                        style="@style/EditorAction"
                        android:text="@string/files" />

                    <TextView
                        android:id="@+id/editorSend"
                        style="@style/EditorAction"
                        android:text="@string/send" />

                    <TextView
                        android:id="@+id/editorUndo"
                        style="@style/EditorAction"
                        android:text="@string/undo" />

                    <TextView
                        android:id="@+id/editorRedo"
                        style="@style/EditorAction"
                        android:text="@string/redo" />

                    <TextView
                        android:id="@+id/editorFind"
                        style="@style/EditorAction"
                        android:text="@string/find" />

                    <TextView
                        android:id="@+id/editorSave"
                        style="@style/EditorAction"
                        android:text="@string/save" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <View
            android:id="@+id/paneDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/divider"
            android:visibility="gone" />

        <!-- Right pane on wide screens: REPL or Registers -->
        <LinearLayout
            android:id="@+id/rightPane"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- REPL -->
            <LinearLayout
                android:id="@+id/replPane"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <ScrollView
                    android:id="@+id/scroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:padding="8dp">

                    <io.github.leukoplast1980.solderless.ui.ConsoleOutputView
                        android:id="@+id/output"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="@color/console_text"
                        android:textIsSelectable="true"
                        android:textSize="14sp" />
                </ScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/bar_background"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:hint="@string/input_hint"
                        android:imeOptions="actionSend|flagNoExtractUi"
                        android:importantForAutofill="no"
                        android:inputType="text|textNoSuggestions"
                        android:maxLines="1"
                        android:textColor="@color/console_text"
                        android:textColorHint="@color/console_hint"
                        android:textSize="14sp" />

                    <io.github.leukoplast1980.solderless.ui.RawInputView
                        android:id="@+id/rawInput"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:text="@string/raw_hint"
                        android:textColor="@color/console_hint"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/send"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/send" />
                </LinearLayout>
            </LinearLayout>

            <!-- Chip: Core, Registers, ... -->
            <LinearLayout
                android:id="@+id/chipPane"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipSections"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        app:chipSpacingHorizontal="6dp"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true" />
                </HorizontalScrollView>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <!-- Core: the CPU's registers, Forth's stacks, the clocks, faults -->
                    <ScrollView
                        android:id="@+id/coreSection"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/registers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="@color/console_text"
                            android:textSize="13sp" />
                    </ScrollView>

                    <!-- Registers: the peripherals' registers and fields -->
                    <LinearLayout
                        android:id="@+id/registersSection"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <EditText
                            android:id="@+id/registerFind"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:fontFamily="monospace"
                            android:hint="@string/registers_find_hint"
                            android:imeOptions="actionSearch|flagNoExtractUi"
                            android:importantForAutofill="no"
                            android:inputType="text|textNoSuggestions|textCapCharacters"
                            android:maxLines="1"
                            android:textColor="@color/console_text"
                            android:textColorHint="@color/console_hint"
                            android:textSize="14sp" />

                        <ScrollView
                            android:id="@+id/registerScroll"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1">

                            <io.github.leukoplast1980.solderless.ui.RegisterListView
                                android:id="@+id/registerList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                        </ScrollView>
                    </LinearLayout>

                    <!-- Clocks: the clock tree -->
                    <ScrollView
                        android:id="@+id/clocksSection"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone">

                        <io.github.leukoplast1980.solderless.ui.ClockView
                            android:id="@+id/clockView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </ScrollView>

                    <!-- Pins: the package, each pin's set-up and wiring -->
                    <ScrollView
                        android:id="@+id/pinsSection"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone">

                        <io.github.leukoplast1980.solderless.ui.PinListView
                            android:id="@+id/pinList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </ScrollView>

                    <!-- Log: register writes and the chip's checks -->
                    <LinearLayout
                        android:id="@+id/logSection"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/logFilters"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="8dp"
                                app:chipSpacingHorizontal="6dp"
                                app:singleLine="true" />
                        </HorizontalScrollView>

                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1">

                            <io.github.leukoplast1980.solderless.ui.LogListView
                                android:id="@+id/logList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                        </ScrollView>
                    </LinearLayout>
                </FrameLayout>

                <!-- Run control, under every section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/bar_background"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:id="@+id/runState"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:maxLines="2"
                        android:textColor="@color/label"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/registersCopy"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="@string/registers_copy" />

                    <Button
                        android:id="@+id/pause"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="@string/pause" />

                    <Button
                        android:id="@+id/step"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="@string/step" />
                </LinearLayout>
            </LinearLayout>


            <!-- Scope -->
            <LinearLayout
                android:id="@+id/scopePane"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/scopeWindow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleSelection="true">

                            <Button android:id="@+id/scopeW10us" style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:minWidth="0dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="10 µs" />
                            <Button android:id="@+id/scopeW100us" style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:minWidth="0dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="100 µs" />
                            <Button android:id="@+id/scopeW1ms" style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:minWidth="0dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="1 ms" />
                            <Button android:id="@+id/scopeW10ms" style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:minWidth="0dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="10 ms" />
                            <Button android:id="@+id/scopeW1s" style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:minWidth="0dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="1 s" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <Button
                            android:id="@+id/scopeHold"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:checkable="true"
                            android:text="@string/scope_hold" />

                        <Button
                            android:id="@+id/scopeTrigger"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/scope_trigger" />
                    </LinearLayout>
                </HorizontalScrollView>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <io.github.leukoplast1980.solderless.ui.ScopeView
                        android:id="@+id/scopeView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </ScrollView>

                <TextView
                    android:id="@+id/scopeReadout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/bar_background"
                    android:fontFamily="monospace"
                    android:padding="10dp"
                    android:textColor="@color/console_text"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Board -->
            <FrameLayout
                android:id="@+id/boardPane"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <ScrollView
                    android:id="@+id/boardScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <io.github.leukoplast1980.solderless.ui.BoardView
                        android:id="@+id/boardView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </ScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">


                        <TextView
                            android:id="@+id/boardWarn"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:background="@drawable/warn_pill"
                            android:gravity="center_vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="@color/chip_message"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/boardSupport"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/board_support_button" />

                        <Button
                            android:id="@+id/boardPins"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:minWidth="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/board_pins_button" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                            android:id="@+id/boardAdd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/board_add_part"
                            app:backgroundTint="@color/accent"
                            app:icon="@drawable/ic_add"
                            app:iconTint="@color/console_background"
                            android:textColor="@color/console_background" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- A pinned pot's wide slider, opened from the floating card -->
    <LinearLayout
        android:id="@+id/potStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/bar_background"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/potStripName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/console_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/potStripValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/analog"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/potMinus"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/pot_down"
                android:insetTop="2dp"
                android:insetBottom="2dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="−"
                android:textSize="20sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/potSlider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/pot_slider"
                android:valueFrom="0"
                android:valueTo="1000"
                android:stepSize="1"
                app:labelBehavior="gone"
                app:thumbColor="@color/bar_text"
                app:thumbWidth="26dp"
                app:thumbHeight="26dp"
                app:thumbTrackGapSize="0dp"
                app:trackStopIndicatorSize="0dp"
                app:tickVisible="false"
                app:trackColorActive="@color/analog"
                app:trackColorInactive="@color/divider"
                app:trackHeight="8dp"
                app:haloColor="@color/analog_dim" />

            <Button
                android:id="@+id/potPlus"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/pot_up"
                android:insetTop="2dp"
                android:insetBottom="2dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="+"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Pinned parts float over every tab but the Board -->
    <LinearLayout
        android:id="@+id/pinned"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:background="@drawable/pinned_card"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone" />
    </FrameLayout>

    <!-- Shared by the REPL and the editor: suggestions and extra keys -->
    <HorizontalScrollView
        android:id="@+id/suggestionScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/suggestions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/extraKeysScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bar_background"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/extraKeys"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>
</LinearLayout>
