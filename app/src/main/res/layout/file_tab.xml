<?xml version="1.0" encoding="utf-8"?>
<!-- One open file in the editor's tab row: unsaved dot, name, close button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="32dp"
    android:layout_marginStart="6dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/file_tab_background"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp">

    <View
        android:id="@+id/tabUnsaved"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginEnd="7dp"
        android:background="@drawable/unsaved_dot"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tabName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tabClose"
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:layout_marginStart="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/close"
        android:gravity="center"
        android:text="@string/close_mark"
        android:textColor="@color/label"
        android:textSize="16sp" />
</LinearLayout>
