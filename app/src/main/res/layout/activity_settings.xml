<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/console_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bar_background"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/settings"
        app:titleTextColor="@color/bar_text" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/text_size"
                    android:textColor="@color/bar_text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textSizeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_size_hint"
                android:textColor="@color/label"
                android:textSize="13sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/textSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1"
                android:value="14"
                android:valueFrom="10"
                android:valueTo="24"
                android:contentDescription="@string/text_size" />

            <TextView
                android:id="@+id/textSizeSample"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/chip_background"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:text="@string/text_size_sample"
                android:textColor="@color/console_text" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:background="@color/divider" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/lineWrap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/line_wrap"
                android:textColor="@color/bar_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/lineWrapHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/line_wrap_hint"
                android:textColor="@color/label"
                android:textSize="13sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/keepScreenOn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/keep_screen_on"
                android:textColor="@color/bar_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/keepScreenOnHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keep_screen_on_hint"
                android:textColor="@color/label"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
