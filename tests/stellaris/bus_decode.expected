\ What the scope's decoder sees, as #!bus prints it: the OLED written over  ok.
\ hardware I2C1, a BMP280 register read (repeated START, a read with NACK),  ok.
\ a part that is not there, then the W25Q on bit-banged SPI.  ok.
#!attach 1 oled PB8 PB9
#!attach 2 bmp280 PB8 PB9
#!attach 3 flash PB12 PB13 PB15 PB14
#!trace PB8 PB9 PB13
$48000400 constant GPIOB  ok.
$40005400 constant I2C1  ok.
: ms ( n -- ) 15999 $E000E014 !  0 $E000E018 !  5 $E000E010 !  ok.
  0 ?do begin $E000E010 @ $10000 and until loop  0 $E000E010 ! ;  ok.
: i2c-init ( -- )  ok.
  %10 $4002104C bis!  1 21 lshift $40021058 bis!  ok.
  %1111 16 lshift GPIOB bic!  %1010 16 lshift GPIOB bis!  %11 8 lshift GPIOB 4 + bis!  ok.
  $FF GPIOB $24 + bic!  $44 GPIOB $24 + bis!  ok.
  0 I2C1 !  $00310F13 I2C1 $10 + !  1 I2C1 ! ;  ok.
: isr@ ( -- u ) I2C1 $18 + @ ;  ok.
: go ( n addr flags -- ) >r 1 lshift swap 16 lshift or r> or 1 13 lshift or I2C1 4 + ! ;  ok.
: >i2c ( b -- ) begin isr@ %10010 and until  isr@ $10 and 0= if I2C1 $28 + ! else drop then ;  ok.
: i2c> ( -- b ) begin isr@ %10100 and until  I2C1 $24 + @ ;  ok.
: end ( -- f ) begin isr@ $20 and until  isr@ $10 and 0=  $30 I2C1 $1C + ! ;  \ STOP; acknowledged?  ok.
: tc ( -- ) begin isr@ %1010000 and until ;  ok.
: reg! ( v reg addr -- ) 2 swap 1 25 lshift go >i2c >i2c end drop ;  ok.
: wr1 ( reg addr -- ) 1 swap 0 go >i2c tc ;                     \ the register pointer; no STOP  ok.
: rdn ( n addr -- ) 1 10 lshift 1 25 lshift or go ;            \ repeated START, read n, STOP  ok.
: regs ( reg addr n -- )  \ the registers from reg on, in hex  ok.
  >r swap over wr1  r@ swap rdn  r> 0 ?do i2c> . loop  end drop ;  ok.
: reg@ ( reg addr -- b ) tuck wr1 1 swap rdn i2c> end drop ;  ok.
hex  ok.
i2c-init  ok.
#!bus
AF 0 3C reg!  ok.
#!bus
+0.0 us hw S
+1.3 us hw addr 3C W ack part 1
+25.7 us hw byte 00 ack
+49.1 us hw byte AF ack
+72.5 us hw P
D0 76 reg@ . 58  ok.
#!bus
+0.0 us hw S
+1.3 us hw addr 76 W ack part 2
+25.7 us hw byte D0 ack
+51.1 us hw S
+52.4 us hw addr 76 R ack part 2
+75.8 us hw read 58 nack
+99.2 us hw P
0 0 50 reg!  ok.
#!bus
+0.0 us hw S
+1.3 us hw addr 50 W nack part -1
+24.7 us hw P
decimal  ok.
: bb-pins ( -- )  ok.
  %10 $4002104C bis!  ok.
  %1011 12 lshift GPIOB $18 + !  1 13 lshift 16 lshift GPIOB $18 + !   \ CS and DI high, CLK low  ok.
  $FF 24 lshift GPIOB bic!  %01000101 24 lshift GPIOB bis! ;          \ PB12, 13, 15 outputs; PB14 input  ok.
: pin! ( f n -- ) 1 swap lshift swap 0= if 16 lshift then GPIOB $18 + ! ;  ok.
: do? ( -- f ) GPIOB $10 + @ 1 14 lshift and 0<> ;  ok.
: bb ( b -- b ) 0 swap 8 0 do dup $80 and 15 pin!  1 13 pin!  swap 2* do? 1 and or swap  0 13 pin!  2* loop drop ;  ok.
: jedec ( -- ) 0 12 pin! $9F bb drop 0 bb hex. 0 bb hex. 0 bb hex. 1 12 pin! ;  ok.
bb-pins jedec 000000EF 00000040 00000017  ok.
#!bus
+0.0 us bb cs part 3 selected
+2.8 us bb spi 9F/FF (MISO not driven) mode 0 part 3 len 30750 ns
+38.8 us bb spi 00/EF mode 0 part 3 len 31062 ns
+688.0 us bb spi 00/40 mode 0 part 3 len 31063 ns
+1469.8 us bb spi 00/17 mode 0 part 3 len 31063 ns
+2249.9 us bb cs part 3 released
\ The same bus bit-banged: the decoder on the pins logs it once, not once per part.  ok.
0 I2C1 !  ok.
: i2c-pins ( -- )  ok.
  %10 $4002104C bis!  ok.
  %11 8 lshift GPIOB 4 + bis!                      \ open-drain  ok.
  %1111 16 lshift GPIOB $18 + !                     \ released (high) before they become outputs  ok.
  %1111 16 lshift GPIOB bic!  %0101 16 lshift GPIOB bis! ;   \ outputs  ok.
: scl-hi 1 8 lshift GPIOB $18 + ! ;  ok.
: scl-lo 1 8 lshift 16 lshift GPIOB $18 + ! ;  ok.
: sda-hi 1 9 lshift GPIOB $18 + ! ;  ok.
: sda-lo 1 9 lshift 16 lshift GPIOB $18 + ! ;  ok.
: sda? ( -- f ) GPIOB $10 + @ 1 9 lshift and 0<> ;  ok.
: i2c-start sda-hi scl-hi sda-lo scl-lo ;  ok.
: i2c-stop sda-lo scl-hi sda-hi ;  ok.
: bit> ( f -- ) if sda-hi else sda-lo then scl-hi scl-lo ;  ok.
: byte> ( b -- ack ) 8 0 do dup $80 and bit> 2* loop drop  sda-hi scl-hi sda? 0= scl-lo ;  ok.
: <byte ( last -- b ) sda-hi 0 8 0 do 2* scl-hi sda? 1 and or scl-lo loop swap bit> ;  ok.
: cmd ( c -- ) i2c-start $3C 2* byte> drop 0 byte> drop byte> drop i2c-stop ;  ok.
: status ( -- b ) i2c-start $3C 2* 1+ byte> drop 1 <byte i2c-stop ;  ok.
: id ( -- b ) i2c-start $76 2* byte> drop $D0 byte> drop i2c-start $76 2* 1+ byte> drop 1 <byte i2c-stop ;  ok.
i2c-pins  ok.
$AF cmd  ok.
