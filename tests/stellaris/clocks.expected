\ get MHz from hclk  ok.
: mhz@ ( -- MHz )  ok.
 hclk @ 1000000 / ;  ok.
   ok.
: systimer-irq-handler  ok.
 1 tick# +! ;  ok.
  ok.
: disableSystimer ( -- )  ok.
    0 STK_CTRL ! ;       \ Disable SysTick    ok.
  ok.
: init-Systimer ( -- )  ok.
    disableSystimer       \ Disable SysTick during setup  ok.
 hclk @ 1000 /        \ 1 ms @ HCLK  ok.
    1- STK_RELOAD !          \ reload value for 24 bit timer  ok.
    0 STK_CURRENT !       \ Any write to current clears it  ok.
 ['] systimer-irq-handler irq-systick !  \ Hook for handler  ok.
 %111 STK_CTRL ! ;      \ AHB-clock, interrupt enabled, counter enabled  ok.
